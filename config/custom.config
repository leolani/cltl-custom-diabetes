# Copy this to config/custom.config (gitignored) to run `python src/main.py`
# against a running cltl-apps deployment as ONE TENANT of it. From this
# module's root directory:
#
#   cp config/custom.config.example config/custom.config
#   OPENAI_API_KEY=... \
#   CLTL_AMQP_URL=amqp://eliza:eliza123@127.0.0.1:5672/ CLTL_TENANT=tenant-a \
#       python src/main.py
#
# CLTL_TENANT must be the tenant of the chat UI you talk to (clients.env).
# Left empty, this module binds `<topic>.#` and answers every tenant.
#
# $VAR interpolation happens at read time; an unset variable is passed on as
# the literal string "$CLTL_TENANT", which then binds a real but permanently
# empty queue. Set every variable used here.

[cltl.event]
implementation: kombu

[cltl.event.kombu]
server: $CLTL_AMQP_URL
exchange: cltl.combot
compression: bzip2
tenant: $CLTL_TENANT

# Anything from [cltl.diabetes] in default.config can be overridden here.
[cltl.diabetes]
# The GraphDB repository holding the conversation history; the SPARQL endpoint
# is <kg_server>/repositories/<kg_repository>. Ignored when CLTL_KG_ADDRESS
# (or kg_address) is set, which compose/diabetes.compose.yml always does.
kg_server: http://localhost:7200
kg_repository: event_sandbox
# human: Mehmet
