# Standalone defaults for `python src/main.py`, and the configuration shipped
# in the Docker image. A deployment does not know about this module, so the
# [cltl.diabetes] section has to come from here; config/custom.config only
# overlays the connection to the deployment's broker (see
# config/custom.config.example).

[cltl.event]
implementation: internal
topic_display: cltl.topic.display       # empty (the default) leaves the tab out

[cltl.diabetes]
topic_input: cltl.topic.text_in
topic_output: cltl.topic.text_out
topic_scenario: cltl.topic.scenario
graph_output: cltl.topic.display
topic_status: cltl.topic.status
# The GraphDB Workbench URL visualising the triples extracted from an
# utterance, published as an agent text signal after the reply. Empty: not
# published.
graph_output: cltl.topic.kg_graph
# The person the agent talks to, as known in the knowledge graph. The last
# conversation and the topics discussed back then are looked up for this name.
human: Jan
# True opens by naming everyone in the knowledge graph the agent has talked
# with, asks the human's name and catches up with that person; `human` (or
# the scenario speaker) is then only used when no name comes out of it.
ask_name: True
# True takes the speaker name from the ScenarioStarted event instead, when it
# carries one, falling back to `human` otherwise.
use_scenario_speaker: False
# `utterance`: open the conversation at the first utterance in a scenario
# (e.g. the "yes" to the platform's greeting). `scenario`: open it as soon as
# the scenario starts.
open_on: utterance
# The GraphDB repository holding the conversation history: its SPARQL
# endpoint is <kg_server>/repositories/<kg_repository>. From inside a
# container, use host.docker.internal instead of localhost.
kg_server: http://localhost:7200
kg_repository: event_sandbox
# The full SPARQL endpoint instead; when set (e.g. through CLTL_KG_ADDRESS,
# as compose/diabetes.compose.yml does), it takes precedence over
# kg_server/kg_repository.
kg_address: $CLTL_KG_ADDRESS
# True empties the whole knowledge graph repository once, when the module
# first connects to it. Everything in it is lost, the conversation history
# included, so the coach starts as if it never talked to anyone.
clear_brain: False
# Where the human is, compared with the last encounter (see cltl/diabetes/place.py):
# in the same city, a visual overlap (scene types and objects seen by the camera)
# of at least place_same_threshold means the same place as last time; at least
# place_ask_threshold asks whether it is; lower, or another city, asks where they are.
place_same_threshold: 0.5
place_ask_threshold: 0.2
# The intents driving the follow-up questions, one or more *.json files.
intents_dir: ./intents
# Chat turns, intent logs and brain logs, written when a scenario stops.
log_dir: ./logs
# Assumed gap when the knowledge graph has no earlier conversation with `human`.
fallback_gap_days: 7
# The LLM for event extraction, questions and replies:
#   openai  OpenAI's API; needs OPENAI_API_KEY.
#   local   a local server with an OpenAI-compatible API at llm_base_url, e.g.
#             llama-server -hf Qwen/Qwen2.5-7B-Instruct-GGUF:Q4_K_M --port 8080 -c 16384
#           The event extraction prompt alone is ~6k tokens, so -c 4096 is too
#           small; use at least 8192, better 16384. No OPENAI_API_KEY needed.
# llm_backend: openai
llm_backend: local
# The API of the local server (llm_backend: local only).
llm_base_url: http://localhost:8080/v1
# The chat model; empty uses the cltl-kg-driven-chat default (gpt-5.1) for
# openai. llama-server serves the model it was started with and ignores this.
model:
# Seconds before an LLM call gives up; a local model on a laptop is slower.
llm_timeout: 60
# Answer the human's questions about their own record ("what did I eat
# yesterday?") by querying the knowledge graph and paraphrasing the result.
answer_questions: True
# Answers longer than this many words are shortened to the gist, and the
# human is asked whether they want the full answer.
max_answer_words: 35

[cltl.event.kombu]
server: amqp://localhost:5672
exchange: cltl.combot
compression: bzip2
