# Standalone defaults for `python src/main.py`, and the configuration shipped
# in the Docker image. A deployment does not know about this module, so the
# [cltl.diabetes] section has to come from here; config/custom.config only
# overlays the connection to the deployment's broker (see
# config/custom.config.example).

[cltl.event]
implementation: internal

[cltl.diabetes]
topic_input: cltl.topic.text_in
topic_output: cltl.topic.text_out
topic_scenario: cltl.topic.scenario
# The person the agent talks to, as known in the knowledge graph. The last
# conversation and the topics discussed back then are looked up for this name.
human: Jan
# True takes the speaker name from the ScenarioStarted event instead, when it
# carries one, falling back to `human` otherwise.
use_scenario_speaker: False
# `utterance`: open the conversation at the first utterance in a scenario
# (e.g. the "yes" to the platform's greeting). `scenario`: open it as soon as
# the scenario starts.
open_on: utterance
# The GraphDB repository holding the conversation history: its SPARQL
# endpoint is <kg_server>/repositories/<kg_repository>. From inside a
# container, use host.docker.internal instead of localhost.
kg_server: http://localhost:7200
kg_repository: event_sandbox
# The full SPARQL endpoint instead; when set (e.g. through CLTL_KG_ADDRESS,
# as compose/diabetes.compose.yml does), it takes precedence over
# kg_server/kg_repository.
kg_address: $CLTL_KG_ADDRESS
# The intents driving the follow-up questions, one or more *.json files.
intents_dir: ./intents
# Chat turns, intent logs and brain logs, written when a scenario stops.
log_dir: ./logs
# Assumed gap when the knowledge graph has no earlier conversation with `human`.
fallback_gap_days: 7
# OpenAI chat model; empty uses the cltl-kg-driven-chat default.
model:
# Answer the human's questions about their own record ("what did I eat
# yesterday?") by querying the knowledge graph and paraphrasing the result.
answer_questions: True
# Answers longer than this many words are summarised.
max_answer_words: 80

[cltl.event.kombu]
server: amqp://localhost:5672
exchange: cltl.combot
compression: bzip2
