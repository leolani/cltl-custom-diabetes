makefile.d

# What the deployment's storage service writes: uploaded images, and audio if
# anything ever records any. The two directories themselves ARE tracked, via
# their .gitkeep files — read one before deleting it.
deployment/storage/*/*
!deployment/storage/*/.gitkeep


**/.DS_Store

# Logs written by this module: chat turns, intent logs and brain logs.
logs/*
!logs/.gitkeep

# Logs written by the notebooks: chat turns, intent logs and brain logs.
notebooks/chat_logs/
notebooks/intents_log/
notebooks/kg_logs/
